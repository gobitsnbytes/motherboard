{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "API_URL",
    "API_INTERNAL_SECRET",
    "DISCORD_CLIENT_ID",
    "DISCORD_CLIENT_SECRET",
    "AUTH_DISCORD_ID",
    "AUTH_DISCORD_SECRET",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SENTRY_*",
        "SENTRY_ENVIRONMENT",
        "SENTRY_RELEASE",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "VERCEL_ENV",
        "VERCEL_GIT_COMMIT_SHA",
        "GITHUB_SHA",
        "GIT_SHA"
      ],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {}
  }
}
