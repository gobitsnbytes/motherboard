# bnb-motherboard environment variables
# Copy this file to .env and replace the placeholder values.

DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id
DATABASE_URL=postgresql+asyncpg://bnb:changeme@localhost:5432/motherboard
SESSION_SECRET=your_session_secret
API_INTERNAL_SECRET=your_api_internal_secret
# UUID of the least-privileged user used by service-to-service API-key calls.
# Do not point this at the first user or a super-admin account.
API_SERVICE_USER_ID=
NEXTAUTH_SECRET=your_nextauth_secret
NEXTAUTH_URL=http://localhost:3000
API_URL=http://localhost:8000

# Optional local-compose helper.
POSTGRES_PASSWORD=changeme

# RazorpayX — Finance & Ledger module (get from RazorpayX Dashboard)
RAZORPAYX_API_KEY=

# Provisioning Sync Scheduler (Optional)
# ENABLE_SYNC_SCHEDULER=false
# SYNC_INTERVAL_MINUTES=15

# Foundation Digital Signature Certificate.  When set, every completed signature
# envelope is sealed with a PAdES signature that any PDF reader can verify.
# Unset, documents still carry the SHA-256 seal and audit certificate.
# Per-signer DSC is not supported: a USB token never releases its private key,
# so a server can verify such a signature but can never produce one.
DSC_PFX_PATH=
DSC_PFX_PASSPHRASE=
# Optional RFC 3161 timestamp authority, e.g. http://timestamp.digicert.com
DSC_TSA_URL=
