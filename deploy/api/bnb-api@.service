[Unit]
Description=BNB API candidate on port %i
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/bnb-api/apps/api
EnvironmentFile=/opt/bnb-api/.env
ExecStart=/opt/bnb-api/apps/api/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port %i --workers 1 --timeout-graceful-shutdown 30
Restart=always
RestartSec=10
RestartForceExitStatus=0
MemoryMax=180M
MemoryHigh=140M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bnb-api-%i

[Install]
WantedBy=multi-user.target
